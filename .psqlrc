-- vim: ft=sql

\set QUIET on
\include ~/.psqlrc_postgres
\include ~/.psqlrc_picodata

\pset linestyle unicode
\pset border 2
\pset null ∅
\set less '\\setenv PAGER less'
\set pspg '\\setenv PAGER \'pspg -s 0\''
:pspg

\timing on

-- fzf history search, bound to Ctrl-R in ~/.inputrc
\set HISTCONTROL ignorespace
\set fzf '\\set _fzf_q `~/.local/bin/fzf-history --no-semicolon ${PSQL_HISTORY:-$HOME/.psql_history}` \\\\ :_fzf_q \\p'

\unset QUIET
