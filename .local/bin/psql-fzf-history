#!/bin/sh
# Pick an entry from psql history with fzf; print it with real newlines.
# psql stores multi-line entries with \001 in place of newlines.
hist=${PSQL_HISTORY:-$HOME/.psql_history}
[ -r "$hist" ] || exit 0
tac "$hist" |
    grep -v -e '^ ' -e '^:' |
    awk '!seen[$0]++' |
    tr '\n\001' '\0\n' |
    fzf --read0 --print0 --scheme=history --height=50% --reverse \
        --gap --highlight-line --query="$*" |
    tr -d '\0' |
    sed -e 's/[[:space:]]*;[[:space:]]*$//'
